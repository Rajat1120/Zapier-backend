generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String
  zaps     Zap[]
  jwtToken String?
  createdAt DateTime @default(now())
  googleToken google_tokens?
  google_drive_watches google_drive_watch[]

 
}

model Zap {
  id        String   @id @default(uuid())
  triggerId String
  userId    Int
  actions   Action[]
  published Boolean  @default(false)
  trigger   Trigger?
  user      User     @relation(fields: [userId], references: [id])
  zapRuns   ZapRun[]
  googleDriveWatch    google_drive_watch?
  @@index([userId])

 
}

model Trigger {
  id           String            @id @default(uuid())
  zapId        String            @unique
  triggerId    String
  triggerEvent String?
  metadata     Json              @default("{}")
  type         AvailableTriggers @relation(fields: [triggerId], references: [id])
  zap          Zap               @relation(fields: [zapId], references: [id])
}

model Action {
  id           String           @id @default(uuid())
  zapId        String
  actionId     String?
  actionEvent  String?
  index        Int
  metadata     Json             @default("{}")
  sortingOrder Int              @default(0)
  type         AvailableActions? @relation(fields: [actionId], references: [id])
  zap          Zap              @relation(fields: [zapId], references: [id])
    @@index([zapId])
  
  
}

model AvailableActions {
  id      String   @id @default(uuid())
  name    String
  image   String   @default("")
  actions Action[]
  @@index([name])
}

model AvailableTriggers {
  id       String    @id @default(uuid())
  name     String
  image    String    @default("")
  triggers Trigger[]
  @@index([name])
}

model ZapRun {
  id           String        @id @default(uuid())
  zapId        String
  metadata     Json
  recursionLevel Int @default(0)
  createdAt    DateTime     @default(now())
  zap          Zap           @relation(fields: [zapId], references: [id])
  zapRunOutbox ZapRunOutbox?
   @@index([zapId])
}

model ZapRunOutbox {
  id       String @id @default(uuid())
  zapRunId String @unique
  zapRun   ZapRun @relation(fields: [zapRunId], references: [id])
}

model google_tokens {
  id            String   @id @default(uuid())
  userId        Int      @unique
  access_token  String
  refresh_token String
  scopes        String[]
  expiresAt     DateTime
  updatedAt     DateTime
  email         String

  user          User     @relation(fields: [userId], references: [id])
   @@index([userId])
}


model google_drive_watch {
  id         String   @id @default(uuid())
  userId     Int
  channelId  String   @unique
  resourceId String
  startPageToken  String 
  expiration DateTime
  zapId       String   @unique
  
  zap        Zap @relation(fields: [zapId], references: [id])

  user       User     @relation(fields: [userId], references: [id])
}